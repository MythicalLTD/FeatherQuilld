<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <Version>0.1.0</Version>
        <InformationalVersion>0.1.0</InformationalVersion>
        <Authors>FeatherQuilld</Authors>
        <Description>FeatherQuilld daemon — light as a feather, sharp as a quill.</Description>
    </PropertyGroup>

    <ItemGroup>
        <Compile Remove="plugins/**" />
        <Compile Remove="sdk/**" />
        <Compile Remove="FeatherQuilld.PluginSdk/**" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="sdk\FeatherQuilld.Plugins.Sdk\FeatherQuilld.Plugins.Sdk.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
        <PackageReference Include="Newtonsoft.Json" Version="13.0.5-beta1" />
        <PackageReference Include="Scalar.AspNetCore" Version="2.16.20" />
        <PackageReference Include="Spectre.Console" Version="0.57.3-alpha.0.7" />
        <PackageReference Include="YamlDotNet" Version="18.1.0" />
    </ItemGroup>

</Project>
