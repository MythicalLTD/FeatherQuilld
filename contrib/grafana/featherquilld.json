      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 27
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (provider, action, result) (rate(featherquilld_proxy_reloads_total{job=~\"$job\",instance=~\"$instance\"}[$__rate_interval])) * 60",
          "legendFormat": "{{provider}} {{action}} {{result}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
